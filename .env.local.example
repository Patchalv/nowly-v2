# Neon Auth (Managed Better Auth)
# Auth URL from the Neon console (Auth > Configuration), e.g.
# https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=your_neon_auth_url
# Signs the session cookies. At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your_32_plus_character_secret

# Neon Data API URL, e.g.
# https://ep-xxx.apirest.<region>.aws.neon.tech/neondb/rest/v1
NEXT_PUBLIC_NEON_DATA_API_URL=your_neon_data_api_url

# Direct Postgres connection string, local only. Used by `npm run db:types`
# and the import script. Never set it in a deployment.
# NEON_DATABASE_URL=postgresql://...

# Google OAuth credentials live in Neon's auth configuration, not here.

# Sentry Configuration
# Leave NEXT_PUBLIC_SENTRY_DSN commented out for local development to disable error reporting
# Only set this in deployed environments (Vercel) to enable Sentry
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# SENTRY_AUTH_TOKEN is required for uploading source maps during production builds
# Get this from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your_sentry_auth_token
